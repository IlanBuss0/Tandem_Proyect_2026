PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/tandem
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
# Generar una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Conservarla fuera del repositorio. Perderla impide recuperar los datos cifrados.
DATA_ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8080

# Opcional. Sin definir, el backend sigue funcionando con fallback (sin rate limit distribuido ni BullMQ).
# REDIS_URL=redis://localhost:6379

# Supabase: storage de archivos y avatares.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_FILES_BUCKET=files

# URL publica del backend (usada por ejemplo en links de emails).
APP_PUBLIC_URL=http://localhost:8080

# Login con Google (frontend + backend deben coincidir en el mismo client id).
GOOGLE_CLIENT_ID=
